# Server-side only. Leave unset for the local synthetic SQL workflow.
NEBIUS_API_KEY=
# Optional official-document lookup. Server-side only; never include in browser code.
TAVILY_API_KEY=
# Missing or unknown mode disables provider calls. The public Worker overrides
# this setting unconditionally. For a trusted loopback Node server/CLI only,
# set mode to private and set ROWGLASS_PUBLIC=false explicitly.
ROWGLASS_PROVIDER_MODE=local-only
# Emergency provider kill switch; overrides private mode.
ROWGLASS_PUBLIC=true
